# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=production-grade-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weather_truck_db

# Redis / Upstash (Broker & Caching)
# For Upstash in production use: rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_ENDPOINT>:6379
UPSTASH_REDIS_URL=redis://localhost:6379/0

# External API Keys
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
TOMORROW_IO_API_KEY=your_tomorrow_io_api_key_here
